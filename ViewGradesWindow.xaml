<Window x:Class="StudentManagementApp.ViewGradesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Grades" Height="450" Width="650"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="NameTextBlock" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>
        <DataGrid x:Name="GradesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Subject" Binding="{Binding SubjectName}" Width="*"/>
                <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="100"/>
                <DataGridTextColumn Header="Grade" Binding="{Binding LetterGrade}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="Close" Grid.Row="2" Width="100" HorizontalAlignment="Right" Margin="0,15,0,0" Click="Close_Click"/>
    </Grid>
</Window>