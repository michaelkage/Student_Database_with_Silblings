<Window x:Class="StudentManagementApp.ViewStudentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registered Student Records"
        Height="450"
        Width="650"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FA">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="System Student Registry"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,10"
                   Foreground="#333333"/>

        <!-- TABLE COLUMNS MAPPED TO SCRIPT PROPERTY VARIABLES -->
        <DataGrid x:Name="dgStudents"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Background="White"
                  RowHeight="28">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Student ID"
                                    Binding="{Binding StudentID}"
                                    Width="120"/>
                <DataGridTextColumn Header="Full Name"
                                    Binding="{Binding Name}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Content="Close Registry Panel"
                Grid.Row="2"
                Height="32"
                Width="150"
                HorizontalAlignment="Right"
                Margin="0,15,0,0"
                Click="BtnClose_Click"/>
    </Grid>
</Window>