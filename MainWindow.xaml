<Window x:Class="StudentManagementApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Database System"
        Height="650"
        Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

        <DockPanel>
                <!-- 1. NOTEPAD-STYLE TOP MENU BAR (Hidden initially until login) -->
                <Menu x:Name="AppMenuBar"
                                DockPanel.Dock="Top"
                                Background="#FFFFFF"
                                Visibility="Collapsed"
                                BorderBrush="#DCDCDC"
                                BorderThickness="0,0,0,1"
                                Padding="4">
                        <Menu.Resources>
                                <Style TargetType="MenuItem">
                                        <Setter Property="FontSize"
                                                        Value="15"/>
                                        <Setter Property="Padding"
                                                        Value="12,5"/>
                                </Style>
                        </Menu.Resources>

                        <MenuItem Header="File">
                                <MenuItem Header="Logout"
                                                Click="MenuLogout_Click"/>
                                <Separator/>
                                <MenuItem Header="Exit"
                                                Click="MenuExit_Click"/>
                        </MenuItem>

                        <MenuItem x:Name="MenuAdminOptions"
                                        Header="Manage">
                                <MenuItem Header="View All Results"
                                                Click="MenuViewAllResults_Click"/>
                                <MenuItem Header="Add New Student"
                                                Click="MenuAddNewStudent_Click"/>
                                <MenuItem Header="Add New Subject"
                                                Click="MenuAddNewSubject_Click"/>
                                <MenuItem Header="Modify Student Data"
                                                Click="MenuModifyStudent_Click"/>
                        </MenuItem>

                        <MenuItem x:Name="MenuStudentOptions"
                                        Header="Profile">
                                <MenuItem Header="View My Grades"
                                                Click="MenuViewMyGrades_Click"/>
                                <MenuItem Header="Edit My Details"
                                                Click="MenuEditMyDetails_Click"/>
                        </MenuItem>
                </Menu>

                <!-- MAIN PANEL HUB -->
                <Grid Margin="20">
                        <!-- A. INITIAL LOGIN PANEL CARD -->
                        <Border x:Name="LoginPanel"
                                        Width="400"
                                        Height="340"
                                        Background="White"
                                        CornerRadius="8"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <StackPanel Margin="25,20">
                                        <TextBlock Text="System Portal Login"
                                                        FontSize="22"
                                                        FontWeight="Bold"
                                                        Foreground="#333333"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,0,0,15"/>

                                        <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,0,0,15">
                                                <RadioButton x:Name="RadioStudent"
                                                                Content="Student"
                                                                IsChecked="True"
                                                                FontSize="14"
                                                                Margin="0,0,25,0"/>
                                                <RadioButton x:Name="RadioAdmin"
                                                                Content="Admin"
                                                                FontSize="14"/>
                                        </StackPanel>

                                        <TextBlock Text="User ID / Username:"
                                                        FontSize="13"
                                                        Foreground="#555555"
                                                        Margin="0,5,0,3"/>
                                        <TextBox x:Name="TxtUsername"
                                                        Height="32"
                                                        VerticalContentAlignment="Center"
                                                        FontSize="14"
                                                        Padding="5,0"/>

                                        <TextBlock Text="Password:"
                                                        FontSize="13"
                                                        Foreground="#555555"
                                                        Margin="0,12,0,3"/>
                                        <PasswordBox x:Name="TxtPassword"
                                                        Height="32"
                                                        VerticalContentAlignment="Center"
                                                        FontSize="14"
                                                        Padding="5,0"/>

                                        <Button Content="Sign In"
                                                        Height="38"
                                                        Margin="0,22,0,0"
                                                        Background="#007ACC"
                                                        Foreground="White"
                                                        FontWeight="Bold"
                                                        FontSize="14"
                                                        Click="BtnLogin_Click"
                                                        Cursor="Hand"/>
                                </StackPanel>
                        </Border>

                        <!-- B. SYSTEM APPLICATION WORKSPACE (Hidden initially) -->
                        <Grid x:Name="WorkspacePanel"
                                        Visibility="Collapsed">
                                <Border Background="White"
                                                CornerRadius="6"
                                                Padding="20">
                                        <StackPanel x:Name="WelcomeView"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">
                                                <TextBlock x:Name="TxtWelcomeHeadline"
                                                                Text="Welcome Dashboard"
                                                                FontSize="26"
                                                                FontWeight="SemiBold"
                                                                Foreground="#222222"
                                                                HorizontalAlignment="Center"/>
                                                <TextBlock Text="Select options from the top-left dropdown menu to execute your workspace tasks."
                                                                FontSize="14"
                                                                Foreground="#666666"
                                                                Margin="0,10,0,0"
                                                                HorizontalAlignment="Center"/>
                                        </StackPanel>
                                </Border>
                        </Grid>
                </Grid>
        </DockPanel>
</Window>