<Window x:Class="StudentManagementApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Database System"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="Logout" Click="MenuLogout_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="MenuExit_Click"/>
            </MenuItem>

            <MenuItem Header="Manage" x:Name="AdminMenu">
                <MenuItem Header="View All Results" Click="MenuViewAllResults_Click"/>
                <MenuItem Header="Manage Student" Click="MenuStudentManagement_Click"/>
                <MenuItem Header="Add New Subject" Click="MenuAddNewSubject_Click"/>
                <MenuItem Header="Change Admin Password" Click="MenuChangeAdminPassword_Click"/>
            </MenuItem>

            <MenuItem Header="Student" x:Name="StudentMenu">
                <MenuItem Header="View My Grades" Click="MenuViewMyGrades_Click"/>
                <MenuItem Header="Manage Offered Subjects (Offer/Drop)" Click="MenuManageSubjects_Click"/>
                <MenuItem Header="Change Password" Click="MenuStudentPassword_Click"/>
                <MenuItem Header="Edit My Details" Click="MenuEditMyDetails_Click"/>
            </MenuItem>
        </Menu>

        <Grid Margin="30">
            <Border Padding="30" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="8">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtWelcomeHeadline"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Text="Welcome"/>
                    <TextBlock Text="Choose an option from the menu above."
                               Margin="0,12,0,0"
                               FontSize="15"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border x:Name="AdminPanel"
                    Visibility="Collapsed"
                    Background="White"
                    Padding="25"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,35">
                <TextBlock Text="Admin session active"
                           FontWeight="SemiBold"/>
            </Border>

            <Border x:Name="StudentPanel"
                    Visibility="Collapsed"
                    Background="White"
                    Padding="25"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,35">
                <TextBlock Text="Student session active"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>