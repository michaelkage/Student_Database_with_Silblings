<Window x:Class="StudentManagementApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentManagementApp"
        mc:Ignorable="d"
        Title="Student Management System"
        Height="450"
        Width="800">

        <Grid>

                <!-- Menu bar -->
                <Menu VerticalAlignment="Top">

                        <!-- Student -->
                        <MenuItem Header="Student">
                                <MenuItem Header="Edit"/>
                                <MenuItem Header="View Results"/>
                                <MenuItem Header="Offer/Drop Subjects"/>
                                <MenuItem Header="Change Password"/>
                        </MenuItem>

                        <!-- Admin -->
                        <MenuItem Header="Admin">
                                <MenuItem Header="Change Admin Password"/>
                                <MenuItem Header="View All Results"/>
                                <MenuItem Header="Enter/Edit Student Result"
                                          Click="EnterEditResult_Click"/>
                                <MenuItem Header="Edit a Student Result"/>
                                <MenuItem Header="Change Offered Subjects for a Student"/>
                                <MenuItem Header="Add a New Subject"
                                          Click="AddNewSubject_Click"/>
                                <MenuItem Header="Add a New Student"
                                          Click="AddNewStudent_Click"/>
                        </MenuItem>

                        <!-- File -->
                        <MenuItem Header="File">

                                <MenuItem Header="Save"/>

                                <MenuItem Header="Save As"/>

                                <Separator/>

                                <MenuItem Header="Exit"/>

                        </MenuItem>

                </Menu>

        </Grid>

</Window>